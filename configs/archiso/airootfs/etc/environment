#
# NeoArch Environment
#

# Default editor
EDITOR=nano
VISUAL=nano

# Default terminal
TERMINAL=konsole

# Qt theme
QT_STYLE_OVERRIDE=Breeze
QT_QPA_PLATFORMTHEME=qt5ct

# GTK theme
GTK_THEME=NeoArch-Purple

# Language
LANG=en_US.UTF-8
LC_COLLATE=C

# Browser
BROWSER=firefox

# XDG
XDG_CONFIG_HOME=$HOME/.config
XDG_CACHE_HOME=$HOME/.cache
XDG_DATA_HOME=$HOME/.local/share
XDG_STATE_HOME=$HOME/.local/state
