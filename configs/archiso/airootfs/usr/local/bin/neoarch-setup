#!/usr/bin/env bash
# NeoArch post-install setup script
# Runs inside the target system after installation
set -euo pipefail

PURPLE='\033[0;35m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

log() { echo -e "${PURPLE}[NeoArch]${NC} $1"; }
success() { echo -e "${GREEN}[✓]${NC} $1"; }
error() { echo -e "${RED}[✗]${NC} $1"; }

NEW_USER=$(logname 2>/dev/null || echo "")

# Configure pacman
log "Configuring pacman..."
sed -i 's/#Color/Color\nILoveCandy/' /etc/pacman.conf
sed -i 's/#ParallelDownloads/ParallelDownloads/' /etc/pacman.conf
sed -i 's/#VerbosePkgLists/VerbosePkgLists/' /etc/pacman.conf
success "pacman configured"

# Set timezone to auto-detect
log "Configuring timezone..."
timedatectl set-ntp true
success "NTP enabled"

# Configure mkinitcpio with optimizations
log "Configuring mkinitcpio..."
sed -i 's/^MODULES=()/MODULES=(btrfs nvme ahci)/' /etc/mkinitcpio.conf
sed -i 's/^COMPRESSION="zstd"/COMPRESSION="zstd"\nCOMPRESSION_OPTIONS=("-T0" "--ultra" "-22")/' /etc/mkinitcpio.conf
mkinitcpio -P
success "initramfs rebuilt"

# Apply systemd optimizations
log "Applying systemd optimizations..."
cat > /etc/systemd/system.conf.d/neoarch.conf << 'SYSD'
[Manager]
DefaultTimeoutStopSec=10s
DefaultLimitNOFILE=524288
DefaultLimitNPROC=65536
SYSD
success "systemd optimized"

# Enable periodic cache cleanup
cat > /etc/systemd/system/paccache.timer << 'PAC'
[Unit]
Description=Clean pacman cache weekly

[Timer]
OnCalendar=weekly
Persistent=true

[Install]
WantedBy=multi-user.target
PAC

cat > /etc/systemd/system/paccache.service << 'PACSRV'
[Unit]
Description=Clean pacman cache

[Service]
Type=oneshot
ExecStart=/usr/bin/paccache -rk3
ExecStart=/usr/bin/paccache -ruk1
PACSRV

systemctl enable paccache.timer
success "pacman cache cleanup enabled"

# Configure pacman mirrorlist
log "Configuring mirrors..."
pacman-mirrors --fasttrack 5 2>/dev/null || true
success "mirrors configured"

# Enable Snapper if installed
if command -v snapper &>/dev/null; then
    log "Configuring Snapper..."
    snapper -c root setup /
    snapper -c home setup /home 2>/dev/null || true
    systemctl enable snapper-timeline.timer
    systemctl enable snapper-cleanup.timer
    success "Snapper configured with automatic snapshots"
fi

# Ensure user is set up
if [[ -n "$NEW_USER" ]]; then
    # Copy theme configs to user
    mkdir -p "/home/$NEW_USER/.config"

    # Configure git
    if command -v git &>/dev/null; then
        cat > "/home/$NEW_USER/.gitconfig" << 'GITCFG'
[color]
    ui = auto
[push]
    default = simple
[init]
    defaultBranch = main
GITCFG
        chown "$NEW_USER:$NEW_USER" "/home/$NEW_USER/.gitconfig"
    fi

    # Configure bash aliases
    cat >> "/home/$NEW_USER/.bashrc" << 'BASHRC'
# NeoArch aliases
alias update='sudo pacman -Syu'
alias install='sudo pacman -S'
alias remove='sudo pacman -Rns'
alias search='pacman -Ss'
alias cleanup='sudo pacman -Sc'
alias orphans='sudo pacman -Rns $(pacman -Qtdq) 2>/dev/null || echo "No orphans"'
alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias grep='grep --color=auto'
alias df='df -h'
alias free='free -h'
alias neofetch='fastfetch'
alias sysinfo='inxi -Fxz'
BASHRC
        chown "$NEW_USER:$NEW_USER" "/home/$NEW_USER/.bashrc"
    fi

    # Qt5/Kvantum theming
    mkdir -p "/home/$NEW_USER/.config/Kvantum"
    chown -R "$NEW_USER:$NEW_USER" "/home/$NEW_USER/.config"
fi

log ""
log "${GREEN}========================================${NC}"
log "${GREEN}  NeoArch setup complete!${NC}"
log "${GREEN}  Welcome to your new system.${NC}"
log "${GREEN}========================================${NC}"
